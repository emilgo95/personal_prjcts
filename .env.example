# ---------------------------------------------------------------------------
# AgriAudit Docs - variables de entorno
# Copia este fichero a .env y ajusta los valores antes de "docker compose up"
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=agriaudit
POSTGRES_USER=agriaudit
POSTGRES_PASSWORD=agriaudit_pw_change_me
# Puerto del host (loopback 127.0.0.1) para conectarte con un cliente (DBeaver, psql...).
# Cámbialo (p. ej. 15432) si ya tienes un PostgreSQL ocupando el 5432.
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=docker

# Seguridad JWT: usa una cadena aleatoria larga (>= 48 caracteres) en produccion
JWT_SECRET=dev-only-secret-please-change-this-to-a-long-random-string-4f8a1
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=7

# Usuario administrador inicial (se crea/actualiza al arrancar el backend)
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD=Admin123!
ADMIN_ORG_NAME=Organización Demo

# Sembrar datos ficticios de demostración al arrancar (solo si la BD está vacía)
AGRIAUDIT_DEMO_SEED=true

# Reconocimiento de texto de evidencias (OCR gratuito y autoalojado, servicio "ocr").
# Deja el valor por defecto para usar el contenedor incluido. Vacío = función desactivada.
AGRIAUDIT_OCR_URL=http://ocr:8000

# Frontend
FRONTEND_PORT=8080

# Almacenamiento de documentos generados y adjuntos (ruta dentro del contenedor)
STORAGE_DIR=/data/storage
